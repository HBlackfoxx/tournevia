# Copy to repository-root .env. Set three distinct passwords; never commit secrets.
# Every setting is explained in deploy/SETTINGS.md.
# Runtime/migration passwords require at least 20 characters.
POSTGRES_DB=vrp
POSTGRES_USER=vrp_owner
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
RUNTIME_DB_USER=vrp_app
RUNTIME_DB_PASSWORD=
MIGRATION_DB_USER=vrp_migrator
MIGRATION_DB_PASSWORD=

# Authenticated loopback workspace. Shared mode requires named accounts and an
# HTTPS PUBLIC_ORIGIN behind trusted TLS; company-use gates remain incomplete.
APP_MODE=local
# Private first-use code, at least 32 random characters. Used only before setup.
# scripts/start_local.py creates this and a private setup link for a local install.
SETUP_TOKEN=
# Optional: enables GET /api/v1/metrics for a monitor (bearer token, at least 32 random characters).
MONITOR_TOKEN=
PUBLIC_ORIGIN=http://localhost:8000
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Compose defaults to the local Docker Desktop graph at host.docker.internal:8002.
# Host Python defaults to 127.0.0.1:8002. Set VALHALLA_URL only to override these.
VALHALLA_URL=
# Set this to the actual extract/provenance used by your routing service.
ROUTING_DATASET=Geofabrik Ile-de-France downloaded 2026-09-22; static OSM speeds
# Optional address lookup through your own BAN geocoder (see docker-compose.geocoder.yml).
# Leave empty to place pins on the map, or to let an administrator choose IGN's public service in
# Settings > Address search. A public geocoder set here would receive every looked-up address.
GEOCODER_URL=
GEOCODER_DATASET=Base Adresse Nationale (Licence Ouverte 2.0)
JOB_TIMEOUT_SECONDS=180
# Keep at 1 unless routing workers and memory have been provisioned for parallel requests.
MATRIX_CONCURRENCY=1
# Largest distance between two points of one calculation; equal to the graph build's --max-matrix-km.
MATRIX_MAX_KM=200

# For host-side Python development only; Compose injects its own database values.
# Set DB_PASSWORD equal to RUNTIME_DB_PASSWORD; match customized runtime values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vrp
DB_USER=vrp_app
DB_PASSWORD=
BIND_HOST=127.0.0.1

# Optional HTTPS overlay only. Does not change the default demo.
# Operator supplies fullchain.pem / privkey.pem; keep them out of Git.
# TLS_PUBLIC_ORIGIN=https://localhost:8443
# TLS_CERT_DIR=C:/absolute/private/certificates
# HTTPS_PORT=8443

# Optional instead: behind an existing HTTPS proxy (docker-compose.proxied.yml).
# start_server.py --behind-proxy writes these (PROXY_ROUTER is then its project name);
# the entrypoint and resolver names are Coolify's.
# TLS_PUBLIC_ORIGIN=https://planner.example.com
# PROXY_NETWORK=coolify
# PROXY_HOST=planner.example.com
# PROXY_ROUTER=tournevia
# PROXY_HTTPS_ENTRYPOINT=https
# PROXY_HTTP_ENTRYPOINT=http
# PROXY_CERT_RESOLVER=letsencrypt

# Optional router inside the stack (docker-compose.routing.yml); start_local.py and
# start_server.py --routing-config write these.
# ROUTING_CONFIG=region/valhalla.json
# ROUTING_THREADS=2
# ROUTING_MEMORY=4g

# Optional geocoder (docker-compose.geocoder.yml).
# GEOCODER_MEMORY=8g
# GEOCODER_WORKERS=2
